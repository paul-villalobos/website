<!-- CSS Styles for rich interactivity and animations -->
<style>
  /* Base transitions & shadow glows */
  .variable-card {
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  /* Styling when a card is checked */
  .variable-card[data-checked="true"] {
    background-color: var(--color-slate-800);
    border-color: #f97316; /* Orange 500 */
    box-shadow: 0 0 16px rgba(249, 115, 22, 0.22);
  }
  
  .variable-card[data-checked="true"] .check-indicator {
    background-color: #ea580c; /* Orange 600 */
    border-color: #ea580c;
  }
  
  .variable-card[data-checked="true"] .check-indicator svg {
    display: block;
  }
  
  .variable-card[data-checked="true"] span.text-slate-500 {
    color: #fdba74; /* Orange 300 */
  }

  /* Hover states for checked/unchecked cards */
  .variable-card:hover {
    transform: translateY(-2px);
  }
  
  .variable-card:active {
    transform: translateY(0);
  }

  /* Moment items list active states */
  li.item-active {
    color: var(--color-slate-900);
    font-weight: 600;
  }
  
  li.item-active .status-box {
    background-color: #ffedd5; /* Orange 100 */
    border-color: #fdba74; /* Orange 300 */
  }
  
  li.item-active .status-box svg {
    display: block;
  }

  /* Downward flow line active animation */
  #vertical-connector-line.flow-active {
    background-color: #f97316; /* orange-500 */
    box-shadow: 0 0 8px rgba(249, 115, 22, 0.4);
  }

  /* Flow badge active states */
  #flow-badge.badge-active {
    border-color: #f97316;
    background-color: #fffaf0; /* amber-50 */
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.15);
  }
  
  #flow-badge.badge-active #flow-badge-check {
    background-color: #ea580c;
    border-color: #ea580c;
  }
  
  #flow-badge.badge-active #flow-badge-check svg {
    display: block;
  }

  /* Completion container active state */
  #step2-completion.complete-active {
    border-color: #22c55e; /* Green 500 */
    background-color: #f0fdf4; /* Green 500 soft */
    box-shadow: 0 4px 10px rgba(34, 197, 94, 0.1);
  }
  
  #step2-completion.complete-active #step2-complete-badge {
    background-color: #16a34a; /* Green 600 */
    border-color: #16a34a;
  }
  
  #step2-completion.complete-active #step2-complete-badge svg {
    display: block;
  }
  
  #step2-completion.complete-active #step2-completion-status {
    color: #16a34a;
  }

  /* Outcome cards state switching */
  .outcome-card.active-red {
    border-color: #ef4444; /* red-500 */
    box-shadow: 0 8px 24px rgba(239, 68, 68, 0.12);
    opacity: 1 !important;
  }
  
  .outcome-card.active-green {
    border-color: #22c55e; /* green-500 */
    box-shadow: 0 8px 24px rgba(34, 197, 94, 0.15);
    opacity: 1 !important;
  }
  
  .outcome-card.active-green .status-indicator {
    background-color: #dcfce7; /* green-100 */
    border-color: #bbf7d0; /* green-200 */
    color: #16a34a; /* green-600 */
  }
  
  .outcome-card.active-green .status-indicator svg {
    display: block;
  }
  
  .outcome-card.active-green #label-efectiva {
    color: #16a34a;
  }
  
  .outcome-card.active-green #sentencia-efectiva-box {
    background-color: #f0fdf4; /* green-50 */
    border-color: #dcfce7; /* green-100 */
  }
  
  .outcome-card.active-green #sentencia-efectiva-label {
    color: #15803d; /* green-700 */
  }
  
  .outcome-card.active-green #sentencia-efectiva-text {
    color: #166534; /* green-800 */
  }

  /* Transition for items */
  .var-label {
    transition: color 0.2s ease-in-out;
  }
  
  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<!-- Client-side logic for the interactive simulator -->
<script>
  // Runs on every page load including transition swaps
  function initSimulator() {
    const cards = document.querySelectorAll('.variable-card');
    const resetButton = document.getElementById('reset-simulator');
    
    // Lists and badges
    const moment1List = document.getElementById('moment-1-list');
    const moment2List = document.getElementById('moment-2-list');
    const verticalLine = document.getElementById('vertical-connector-line');
    const flowBadge = document.getElementById('flow-badge');
    const step2Completion = document.getElementById('step2-completion');
    const step2CompletionStatus = document.getElementById('step2-completion-status');
    const rightArrow = document.getElementById('flow-arrow-right');
    
    // Outcomes
    const outcomeNoEfectiva = document.getElementById('outcome-no-efectiva');
    const outcomeEfectiva = document.getElementById('outcome-efectiva');
    
    // Dynamic text
    const datoDuroEfectiva = document.getElementById('dato-duro-efectiva');
    const sentenciaEfectivaText = document.getElementById('sentencia-efectiva-text');
    
    if (!cards.length) return;

    // Track active variables
    let checkedVars = new Set();

    // Moment technical vs logistic arrays
    const technicalIds = [1, 4, 7, 8, 9];
    const logisticIds = [2, 3, 5, 6];

    function updateSimulation() {
      // 1. Reset list items styles in Paso 2
      document.querySelectorAll('[data-link-id]').forEach(item => {
        item.classList.remove('item-active');
      });

      // 2. Loop through all checked card IDs
      checkedVars.forEach(id => {
        const item = document.querySelector(`[data-link-id="${id}"]`);
        if (item) {
          item.classList.add('item-active');
        }
      });

      // 3. Evaluate Moment 1 technical validation (Requires at least one technical variable)
      const hasTechnicalChecked = technicalIds.some(id => checkedVars.has(id));
      // Specifically check for technical pain variable (ID 9: Dolores Técnicos)
      const hasDolorTecnicoChecked = checkedVars.has(9);
      
      if (hasTechnicalChecked) {
        verticalLine?.classList.add('flow-active');
        flowBadge?.classList.add('badge-active');
      } else {
        verticalLine?.classList.remove('flow-active');
        flowBadge?.classList.remove('badge-active');
      }

      // 4. Evaluate Moment 2 completion (Requires at least 2 financial/logistical variables checked)
      const logisticCheckedCount = logisticIds.filter(id => checkedVars.has(id)).length;
      const isMoment2Complete = logisticCheckedCount >= 2;
      
      if (isMoment2Complete) {
        step2Completion?.classList.add('complete-active');
        if (step2CompletionStatus) {
          step2CompletionStatus.textContent = 'VALIDADO';
        }
      } else {
        step2Completion?.classList.remove('complete-active');
        if (step2CompletionStatus) {
          step2CompletionStatus.textContent = 'INCOMPLETO';
        }
      }

      // 5. Evaluate Step 3 (The Binary Gate)
      const totalChecked = checkedVars.size;
      if (resetButton) {
        resetButton.textContent = `Limpiar variables (${totalChecked}/9)`;
      }

      if (totalChecked > 0) {
        // Active "Visita Efectiva"
        outcomeNoEfectiva?.classList.remove('active-red');
        outcomeNoEfectiva?.classList.add('opacity-40');
        
        outcomeEfectiva?.classList.add('active-green');
        outcomeEfectiva?.classList.remove('opacity-60');
        
        if (rightArrow) {
          rightArrow.classList.add('text-green-500');
          rightArrow.classList.remove('text-slate-400');
        }

        // Generate dynamic lists of collected variables for "Dato Duro"
        const collectedNames = [];
        checkedVars.forEach(id => {
          const card = document.querySelector(`.variable-card[data-id="${id}"]`);
          if (card) {
            collectedNames.push((card as HTMLElement).dataset.name);
          }
        });

        // Set the text in Visita Efectiva
        if (datoDuroEfectiva) {
          datoDuroEfectiva.innerHTML = `<strong>Registrado:</strong> ${collectedNames.join(', ')}.`;
        }

        if (sentenciaEfectivaText) {
          // If we also collected a technical pain, the pipeline predictibility is high
          if (hasDolorTecnicoChecked) {
            sentenciaEfectivaText.innerHTML = 'Tu gestión hoy generó <strong>predictibilidad científica</strong> en el pipeline. Hito técnico clínico validado.';
          } else {
            sentenciaEfectivaText.innerHTML = 'Hitos levantados con éxito. Tu gestión comercial cuenta con datos objetivos para avanzar la fase.';
          }
        }
      } else {
        // Reset to "Visita No Efectiva"
        outcomeNoEfectiva?.classList.add('active-red');
        outcomeNoEfectiva?.classList.remove('opacity-40');
        
        outcomeEfectiva?.classList.remove('active-green');
        outcomeEfectiva?.classList.add('opacity-60');
        
        if (rightArrow) {
          rightArrow.classList.remove('text-green-500');
          rightArrow.classList.add('text-slate-400');
        }

        if (datoDuroEfectiva) {
          datoDuroEfectiva.textContent = 'Ningún hito guardado.';
        }
        if (sentenciaEfectivaText) {
          sentenciaEfectivaText.textContent = 'Debes levantar datos para generar predictibilidad científica en el pipeline.';
        }
      }
    }

    // Toggle card selection
    cards.forEach(card => {
      card.addEventListener('click', () => {
        const id = parseInt((card as HTMLElement).dataset.id || '0');
        const isChecked = (card as HTMLElement).dataset.checked === 'true';
        
        if (isChecked) {
          (card as HTMLElement).dataset.checked = 'false';
          checkedVars.delete(id);
        } else {
          (card as HTMLElement).dataset.checked = 'true';
          checkedVars.add(id);
        }
        
        updateSimulation();
      });
    });

    // Reset simulator trigger
    resetButton?.addEventListener('click', () => {
      cards.forEach(card => {
        (card as HTMLElement).dataset.checked = 'false';
      });
      checkedVars.clear();
      updateSimulation();
    });

    // Initial run
    updateSimulation();
  }

  // Support Astro view transitions
  document.addEventListener('astro:page-load', initSimulator);
  // Fallback for regular navigations
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSimulator);
  } else {
    initSimulator();
  }
</script>
