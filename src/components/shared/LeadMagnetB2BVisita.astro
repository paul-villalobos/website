---
// Component: LeadMagnetB2BVisita.astro
// Interactive B2B Sales Visit Diagnostic Simulator
// Based on the Oli Gardner Framework & VoxCliente Engine v2.5
---

<div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 bg-slate-50 border border-slate-200 rounded-3xl shadow-xl overflow-hidden font-sans">
  
  <!-- Interactive simulator header -->
  <div class="text-center mb-10">
    <span class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-orange-100 text-orange-700 border border-orange-200 inline-block mb-3">
      Simulador Interactivo B2B
    </span>
    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight">
      La Visita B2B Efectiva y las 9 Variables del Diagnóstico Iterativo
    </h2>
    <p class="mt-3 text-lg text-slate-600 max-w-3xl mx-auto">
      Haz clic en las variables del <strong class="text-slate-800">Paso 1</strong> para simular el levantamiento de información en campo y observa cómo impacta en el pipeline y la efectividad de la visita en tiempo real.
    </p>
  </div>

  <!-- The Simulator Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    
    <!-- PASO 1: EL DICCIONARIO DE TRINCHERA (5 / 12 Cols) -->
    <div class="lg:col-span-5 bg-slate-900 text-white rounded-2xl p-6 flex flex-col justify-between shadow-md border border-slate-800">
      <div>
        <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-4">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-orange-500">Paso 1</h3>
            <h4 class="text-lg font-bold text-white mt-1">EL DICCIONARIO DE TRINCHERA</h4>
          </div>
          <span class="text-xs bg-slate-800 px-3 py-1 rounded-full text-slate-300 font-semibold border border-slate-700">
            9 Variables Técnicas
          </span>
        </div>
        <p class="text-xs text-slate-400 mb-6 leading-relaxed">
          Variables técnicas que separan el commodity del margen. <span class="text-orange-400 font-semibold">Ejemplo Práctico: Venta de Manjar para Tortas.</span>
        </p>

        <!-- 3x3 / Responsive grid of variables -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="dictionary-grid">
          
          <!-- Variable 1 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="1" 
            data-moment="1"
            data-name="Insumo Actual"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">1</span>
              <!-- Check icon wrapper -->
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Jar Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" class="hidden" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 11a4 4 0 100-8 4 4 0 000 8z" class="hidden" />
                <!-- Custom Bucket Jar path -->
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 8h12M7 8l1 11a2 2 0 002 2h4a2 2 0 002-2l1-11M9 5a3 3 0 016 0v3H9V5z" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">Insumo Actual</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿Qué manjar usa para la torta?</p>
            </div>
          </button>

          <!-- Variable 2 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="2" 
            data-moment="2"
            data-name="Consumo Mensual"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">2</span>
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Cake/Pastry Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V6a2 2 0 10-2 2h2zm-9 5h18v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6zm0 0c0-1.657 4.03-3 9-3s9 1.343 9 3" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">Consumo Mensual</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿Cuántos baldes compras? / Tortas horneas</p>
            </div>
          </button>

          <!-- Variable 3 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="3" 
            data-moment="2"
            data-name="Costo Actual"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">3</span>
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Cost/Dollar Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-28h6M9 10h6m-7 4h8a2 2 0 100-4H8a2 2 0 100 4zm2 8a2 2 0 104 0h-4z" class="hidden" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">Costo Actual</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿Puedo ver la factura de su última compra?</p>
            </div>
          </button>

          <!-- Variable 4 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="4" 
            data-moment="1"
            data-name="Marca Competidora"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">4</span>
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Tag/Competitor Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581a1.43 1.43 0 002.022 0l4.318-4.318a1.43 1.43 0 000-2.022L11.16 3.659A2.25 2.25 0 009.568 3z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">Marca Competidora</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿Qué marca usan para el relleno base?</p>
            </div>
          </button>

          <!-- Variable 5 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="5" 
            data-moment="2"
            data-name="Proveedor Actual"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">5</span>
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Vendor/Supplier Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">Proveedor Actual</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿Dónde lo compras hoy en día?</p>
            </div>
          </button>

          <!-- Variable 6 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="6" 
            data-moment="2"
            data-name="Oferta de Valor"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">6</span>
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Value Prop/Financing Tag Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">Oferta de Valor</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿El proveedor te da auspicios o crédito?</p>
            </div>
          </button>

          <!-- Variable 7 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="7" 
            data-moment="1"
            data-name="Uso Específico"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">7</span>
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Funnel Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">Uso Específico</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿Cómo usas el manjar? (Relleno, decorado)</p>
            </div>
          </button>

          <!-- Variable 8 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="8" 
            data-moment="1"
            data-name="Por Qué lo Eligió"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">8</span>
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Brain/Preferences Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18a3.75 3.75 0 00.495-7.467 5.99 5.99 0 00-1.925-3.546 5.974 5.974 0 01-2.133-1A3.75 3.75 0 002.25 6v.18a6.009 6.009 0 014.522 5.82h-.022A3.75 3.75 0 0010.5 15.75v.022a6.009 6.009 0 01-4.522 5.82V21.75a3.75 3.75 0 003.75-3.75z" class="hidden" />
                <!-- Actual brain icon profile -->
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.5 9.5a3 3 0 116 0 3 3 0 01-6 0zM12 12.5V21M12 12.5a5.5 5.5 0 11-5.5-5.5M12 12.5a5.5 5.5 0 105.5-5.5" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">¿Por qué lo eligió?</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿Por qué lo prefiere ante otras marcas?</p>
            </div>
          </button>

          <!-- Variable 9 -->
          <button 
            type="button" 
            class="variable-card group relative flex flex-col justify-between text-left p-3 rounded-xl bg-slate-800 hover:bg-slate-750 border border-slate-700 hover:border-orange-500/50 transition-all duration-200 cursor-pointer select-none focus:outline-none focus:ring-2 focus:ring-orange-500" 
            data-id="9" 
            data-moment="1"
            data-name="Dolores Técnicos"
            data-checked="false"
          >
            <div class="flex justify-between items-start w-full">
              <span class="text-xs font-black text-slate-500 group-hover:text-slate-300 transition-colors">9</span>
              <span class="check-indicator w-4.5 h-4.5 rounded-md border border-slate-600 bg-slate-900 flex items-center justify-center transition-all">
                <svg class="w-3 h-3 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </span>
            </div>
            
            <div class="mt-4 mb-2 flex flex-col items-center justify-center h-10 w-full text-orange-500 group-hover:scale-110 transition-transform">
              <!-- Warning/Technical Pain Icon -->
              <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
            
            <div>
              <h5 class="text-[10px] font-bold tracking-wider text-slate-200 uppercase leading-tight truncate">Dolores Técnicos</h5>
              <p class="text-[9px] text-slate-400 leading-tight mt-0.5 line-clamp-2">¿Tienen mermas por chorreo o humedad?</p>
            </div>
          </button>
          
        </div>
      </div>
      
      <!-- Paso 1 instructions footer -->
      <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between text-[11px] text-slate-400">
        <span>Haz clic para seleccionar variables</span>
        <button id="reset-simulator" type="button" class="text-orange-500 hover:text-orange-400 hover:underline font-bold transition-all focus:outline-none">
          Limpiar variables (0/9)
        </button>
      </div>
    </div>

    <!-- PASO 2: ESTRATEGIA DE DESPLIEGUE EN CAMPO (4 / 12 Cols) -->
    <div class="lg:col-span-4 bg-slate-100 rounded-2xl p-6 border border-slate-200 flex flex-col justify-between shadow-sm">
      
      <div class="flex flex-col h-full">
        <!-- Title and header -->
        <div class="border-b border-slate-200 pb-4 mb-4">
          <h3 class="text-xs font-bold uppercase tracking-widest text-slate-500">Paso 2</h3>
          <h4 class="text-lg font-bold text-slate-900 mt-1">DESPLIEGUE EN CAMPO</h4>
          <p class="text-xs text-slate-500 leading-tight mt-1">
            No dispares a ciegas. Divide la cuenta en dos momentos clínicos:
          </p>
        </div>

        <div class="space-y-6 flex-grow flex flex-col justify-between">
          <!-- MOMENTO 1 -->
          <div class="bg-white rounded-xl p-4 border border-slate-200/80 shadow-xs relative">
            <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
              <div class="flex items-center space-x-2">
                <!-- Chef hat SVG -->
