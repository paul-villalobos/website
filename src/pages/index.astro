  <!-- SEO Keywords: servicios IA para ventas, chatbot de ventas, automatización comercial, CRM con IA, entrenamiento IA empresarial -->
  <!-- 🔹 5. Servicios alineados al AI Sales Engine -->
  <section id="servicios" class="py-section bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <div class="max-w-4xl mx-auto space-y-12">
        <SectionHeader title="Servicios alineados al AI Sales Engine" />
        <div class="space-y-8">
          <ServiceCard
            title="1. Chatbot de Ventas Inteligente"
            description="El asistente que responde, califica y agenda por tu equipo."
            resultado="mayor velocidad de respuesta, menos mensajes perdidos y leads mejor priorizados."
            incluye="diseño del flujo conversacional, prompts optimizados, calificación automática, handoff a vendedor e integración básica con CRM o correo."
            impacta="Fase 2 y Fase 3."
            icon="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            colorVariant="primary"
          />
          <ServiceCard
            title="2. Automatización de Procesos Comerciales"
            description="Elimina tareas manuales y estandariza la ejecución del equipo."
            resultado="más tiempo para vender, menos errores operativos y procesos consistentes."
            incluye="mapeo de procesos, automatización de seguimientos, secuencias, alertas, workflows y tableros de control simples."
            impacta="Fase 3, Fase 5 y Fase 6."
            icon="M13 10V3L4 14h7v7l9-11h-7z"
            colorVariant="secondary"
          />
          <ServiceCard
            title="3. CRM con IA para Equipos Comerciales"
            description="Ordena tu proceso comercial y dale al equipo un CRM que realmente usarán."
            resultado="pipeline más limpio, visibilidad real y decisiones basadas en datos."
            incluye="estructura del CRM, campos clave, etapas del funnel, vistas optimizadas e IA para priorización y seguimiento inteligente."
            impacta="Fase 2, 3, 4 y 8."
            icon="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
            colorVariant="accent"
          />
          <ServiceCard
            title="4. Cursos y Entrenamientos en IA Aplicada a Ventas"
            description="Entrenamientos prácticos para que tu equipo adopte la IA sin frustración técnica."
            resultado="vendedores capaces de usar IA en prospección, seguimiento, negociación y cierre."
            incluye="talleres en vivo, guías, plantillas, ejercicios reales y acompañamiento en implementación."
            impacta="Todas las fases."
            icon="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
            colorVariant="primary"
          />
          <ServiceCard
            title="5. Implementación del AI Sales Engine (Consultoría Completa)"
            description="La metodología completa para integrar IA en todas las fases del proceso comercial."
            resultado="un sistema comercial ordenado, medible y asistido por IA, listo para escalar."
            incluye="diagnóstico, diseño del sistema, mapa de automatizaciones, CRM inteligente, entrenamientos y acompañamiento 1:1."
            impacta="Absolutamente todas las fases."
            icon="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"
            colorVariant="secondary"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Keywords: casos de éxito IA en ventas, aumento de conversión, testimonios IA comercial -->
  <!-- 🔹 6. Casos de éxito — Resultados reales -->
  <section
    id="casos-exito"
    class="py-section bg-linear-to-b from-(--pv-bg-alt) to-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <div class="max-w-4xl mx-auto space-y-12">
        <SectionHeader
          title="Ejemplo ilustrativo de impacto con el AI Sales Engine"
          subtitle="(Este ejemplo muestra cómo suelen verse los resultados cuando se implementa la metodología. No representa un caso real ni un cliente específico.)"
          class="mb-8"
        />
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div class="bg-white border border-(--pv-border-mid) rounded-2xl p-8">
            <h3 class="text-xl font-semibold text-ink-base mb-6">
              Implementación típica incluye:
            </h3>
            <ul class="space-y-4 text-ink-muted">
              <li class="flex items-start space-x-3">
                <span class="text-primary mt-1">✓</span>
                <span>Chatbot de calificación</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-primary mt-1">✓</span>
                <span>Secuencias automatizadas</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-primary mt-1">✓</span>
                <span>CRM con IA para priorización</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-primary mt-1">✓</span>
                <span>Automatización de tareas</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-primary mt-1">✓</span>
                <span>Seguimiento inteligente del pipeline</span>
              </li>
            </ul>
          </div>
          <div class="bg-white border border-(--pv-border-mid) rounded-2xl p-8">
            <h3 class="text-xl font-semibold text-ink-base mb-6">
              Resultados esperados:
            </h3>
            <ul class="space-y-4 text-ink-muted">
              <li class="flex items-start space-x-3">
                <span class="text-(--pv-success) mt-1">•</span>
                <span>Menos tareas manuales</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-(--pv-success) mt-1">•</span>
                <span>Más velocidad de respuesta</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-(--pv-success) mt-1">•</span>
                <span>Pipeline más limpio</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-(--pv-success) mt-1">•</span>
                <span>Mayor visibilidad</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-(--pv-success) mt-1">•</span>
                <span>Mejor seguimiento</span>
              </li>
              <li class="flex items-start space-x-3">
                <span class="text-(--pv-success) mt-1">•</span>
                <span>Equipos usando IA sin complejidad</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

