---
import MainLayout from "../layouts/MainLayout.astro";
import Button from "../components/shared/Button.astro";
import ServiceCard from "../components/home/ServiceCard.astro";
import ProcessStep from "../components/home/ProcessStep.astro";
import SectionHeader from "../components/home/SectionHeader.astro";
import ContentCard from "../components/home/ContentCard.astro";
import CTACard from "../components/home/CTACard.astro";
import PhaseCard from "../components/home/PhaseCard.astro";
import {
  AUTHOR_NAME,
  SITE_URL,
  SITE_TITLE,
  SITE_DESCRIPTION,
  DEFAULT_KEYWORDS,
  AUTHOR_LINKEDIN,
  AUTHOR_TWITTER_URL,
} from "../utils/constants";

// Generar metadatos SEO para la página de inicio
const homeMeta = {
  title: SITE_TITLE,
  description: SITE_DESCRIPTION,
  keywords: DEFAULT_KEYWORDS,
  canonical: SITE_URL,
  ogImage: "https://paulvillalobos.com/images/og-default.jpg", // Placeholder or default
  ogType: "website",
};

const homeStructuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: AUTHOR_NAME,
  jobTitle: "Especialista en Inteligencia Artificial Aplicada a Ventas",
  description:
    "Líder en ventas B2B y tecnología aplicada a resultados. Más de una década transformando la gestión comercial con inteligencia artificial.",
  url: SITE_URL,
  sameAs: [AUTHOR_LINKEDIN, AUTHOR_TWITTER_URL],
  knowsAbout: [
    "Inteligencia Artificial",
    "Ventas B2B",
    "Automatización Comercial",
    "CRM",
    "Estrategias de Ventas",
  ],
  offers: {
    "@type": "Service",
    serviceType: "Consultoría en Inteligencia Artificial Aplicada a Ventas",
    areaServed: {
      "@type": "Place",
      name: "Latinoamérica",
    },
    availableChannel: {
      "@type": "ServiceChannel",
      serviceUrl: SITE_URL,
    },
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Servicios AI Sales Engine",
      itemListElement: [
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Chatbot de Ventas Inteligente",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Automatización de Procesos Comerciales",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "CRM con IA para Equipos Comerciales",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Cursos y Entrenamientos en IA Aplicada a Empresa",
          },
        },
        {
          "@type": "Offer",
          itemOffered: {
            "@type": "Service",
            name: "Implementación del AI Sales Engine",
          },
        },
      ],
    },
  },
};
---

<MainLayout
  title={homeMeta.title}
  description={homeMeta.description}
  keywords={homeMeta.keywords}
  canonical={homeMeta.canonical}
  ogImage={homeMeta.ogImage}
  ogType={homeMeta.ogType}
  structuredData={homeStructuredData}
>
  <!-- SEO Keywords: inteligencia artificial en ventas, IA comercial, AI Sales Engine, consultoría IA ventas -->
  <!-- 🔹 1. HERO — Posicionamiento Directo y Premium -->
  <section
    id="hero"
    class="min-h-[560px] flex items-center bg-linear-to-br from-white via-(--pv-primary-soft) to-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-5 py-section w-full">
      <div class="max-w-[820px] mx-auto text-center space-y-8">
        <h1 class="text-display text-ink-base">
          IA Comercial para Equipos de Ventas
        </h1>
        <p
          class="text-lg sm:text-xl text-ink-muted leading-relaxed max-w-3xl mx-auto"
        >
          Un sistema comercial claro y aplicable para integrar IA en ventas sin
          proyectos gigantes ni complejidad técnica.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
          <!-- <Button href="#contacto" variant="primary" size="md">
						Agenda tu Diagnóstico IA Comercial
					</Button> -->
          <!-- TODO: Lead Magnet: Canvas AI Sales Engine -->
          <!-- <Button href="#" variant="ghost" size="md">
						Descargar AI Sales Engine Canvas (gratis)
					</Button> -->
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Keywords: problemas comerciales empresas, CRM sin uso, seguimiento comercial, IA para solucionar ventas -->
  <!-- 🔹 2. El problema que viven hoy los equipos comerciales -->
  <section
    id="problema"
    class="py-section bg-linear-to-b from-(--pv-bg-alt) to-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <div class="max-w-4xl mx-auto space-y-8">
        <SectionHeader
          title="El problema que viven hoy los equipos comerciales"
          class="mb-12"
        />
        <div class="space-y-6 text-lg text-ink-muted leading-relaxed">
          <p>Las empresas ya saben que necesitan IA…</p>
          <p>
            Pero no saben por dónde empezar, qué herramientas usar o cómo
            encajarlas en su proceso comercial actual.
          </p>
          <p class="font-semibold text-ink-base mt-8 mb-4">
            Los síntomas más comunes:
          </p>
          <ul class="space-y-4 list-none">
            <li class="flex items-start space-x-3">
              <span class="text-primary mt-1">•</span>
              <span>CRM sin uso o con información incompleta</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-primary mt-1">•</span>
              <span>Seguimiento lento y poco predecible</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-primary mt-1">•</span>
              <span>Tareas repetitivas que consumen horas</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-primary mt-1">•</span>
              <span>Leads sin atender o mal calificados</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-primary mt-1">•</span>
              <span>Propuestas demoradas</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-primary mt-1">•</span>
              <span>Falta de data para tomar decisiones</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-primary mt-1">•</span>
              <span>Cierres que dependen "solo del vendedor"</span>
            </li>
            <li class="flex items-start space-x-3">
              <span class="text-primary mt-1">•</span>
              <span>Postventa sin estructura</span>
            </li>
          </ul>
          <p class="mt-8">
            La mayoría de equipos comerciales ya sienten el desgaste: procesos
            desordenados, tareas manuales, poca visibilidad del pipeline y
            vendedores que no están usando su tiempo de forma estratégica. Y la
            IA no va a resolver nada por sí sola si el proceso base no está
            ordenado.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Keywords: AI Sales Engine, sistema comercial con IA, metodología IA ventas, funnel con IA -->
  <!-- 🔹 3. AI Sales Engine — Tu nuevo sistema comercial impulsado por IA -->
  <section id="ai-sales-engine" class="py-section bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <div class="max-w-4xl mx-auto space-y-12">
        <SectionHeader
          title="AI Sales Engine — Sistema comercial impulsado por IA"
          subtitle="Un sistema comercial práctico, diseñado para equipos que necesitan integrar IA en sus procesos sin fricción."
        />
        <div class="space-y-6">
          <p class="text-xl font-semibold text-ink-base">
            Las 8 fases del AI Sales Engine:
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <PhaseCard
              title="IA DemandGen"
              description="Generación inteligente de demanda"
              colorVariant="primary"
            />
            <PhaseCard
              title="IA Engagement & Prospección"
              description="Captura y calificación automática"
              colorVariant="secondary"
            />
            <PhaseCard
              title="IA Discovery Profundo"
              description="Entendimiento real del cliente con IA"
              colorVariant="accent"
            />
            <PhaseCard
              title="AI Proposal Engine"
              description="Propuestas rápidas y personalizadas"
              colorVariant="primary"
            />
            <PhaseCard
              title="AI Closing & Negotiation"
              description="Aceleración del cierre comercial"
              colorVariant="secondary"
            />
            <PhaseCard
              title="AI Delivery & Customer Success"
              description="Onboarding + postventa"
              colorVariant="accent"
            />
            <PhaseCard
              title="AI Expansion & Monetización"
              description="Upsell, cross-sell y retención"
              colorVariant="primary"
            />
            <PhaseCard
              title="AI Data Loop"
              description="Inteligencia comercial y mejora continua"
              colorVariant="alt"
            />
          </div>
          <div
            class="bg-gradient-to-br from-[var(--pv-bg-alt)] to-white rounded-2xl p-8 lg:p-12 border border-[var(--pv-border-mid)] mt-8"
          >
            <p class="text-xl font-semibold text-ink-base mb-4 text-center">
              Promesa del sistema:
            </p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
              <div>
                <p class="text-lg font-bold text-primary">Más velocidad.</p>
              </div>
              <div>
                <p
                  class="text-lg font-bold"
                  style="color: var(--pv-secondary-base);"
                >
                  Menos fricción.
                </p>
              </div>
              <div>
                <p
                  class="text-lg font-bold"
                  style="color: var(--pv-accent-base);"
                >
                  Más precisión.
                </p>
              </div>
              <div>
                <p class="text-lg font-bold text-primary">Mejor ejecución.</p>
              </div>
            </div>
            <p class="text-center text-ink-muted mt-6">
              Sin proyectos gigantes y sin humo.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mini sección sobre Paul Villalobos -->
  <section id="sobre-paul" class="py-section bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <div class="max-w-3xl mx-auto">
        <div
          class="bg-gradient-to-br from-[var(--pv-bg-alt)] to-white rounded-2xl p-8 lg:p-10 border border-[var(--pv-border-mid)]"
        >
          <h3 class="text-2xl font-bold text-ink-base mb-4">
            Sobre Paul Villalobos
          </h3>
          <div class="space-y-4 text-ink-muted leading-relaxed">
            <p>
              Consultor en estrategia comercial e inteligencia artificial
              aplicada a ventas.
            </p>
            <p>
              10 años trabajando en ventas B2B, canales, pricing, CRM, data
              analytics y automatización comercial.
            </p>
            <p>
              Ayudo a empresas a ordenar su proceso comercial e implementar IA
              de forma práctica, simple y medible. Mi enfoque combina lo técnico
              (data, sistemas, automatización) con lo comercial (ventas,
              ejecución, gestión), para que los equipos vendan más con menos
              fricción.
            </p>
            <p>
              Creo que los equipos comerciales merecen una forma moderna, clara
              y alcanzable de usar IA — sin proyectos complejos, sin consultoría
              inentendible y sin depender de tecnología que nunca se adopta. Mi
              trabajo es convertir la IA en herramientas reales que mejoran la
              ejecución comercial desde el primer mes.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Keywords: implementación IA comercial, diagnóstico comercial IA, quick wins IA, automatización ventas -->
  <!-- 🔹 4. Cómo trabajamos — De diagnóstico a impacto real -->
  <section
    id="como-trabajamos"
    class="py-section bg-gradient-to-b from-white to-[var(--pv-bg-alt)]"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-5">
      <div class="max-w-4xl mx-auto space-y-12">
        <SectionHeader
          title="Cómo trabajamos — De diagnóstico a impacto real"
        />
        <div class="space-y-8">
          <ProcessStep
            number={1}
            title="Diagnóstico IA Comercial"
            description="Mapeamos tus 8 fases actuales y detectamos cuellos de botella."
            colorVariant="primary"
          />
          <ProcessStep
            number={2}
            title="Quick Wins"
            description="Implementamos mejoras rápidas que mueven la aguja desde el primer mes."
            colorVariant="secondary"
          />
          <ProcessStep
            number={3}
            title="Integración IA en procesos reales"
            description="Automatizamos, estructuramos y potenciamos lo que ya tienes."
            colorVariant="accent"
          />
          <ProcessStep
            number={4}
            title="Habilitación del equipo"
            description="Formamos a tu equipo para que realmente use la IA día a día."
            colorVariant="primary"
          />
          <ProcessStep
            number={5}
            title="Medición y escalamiento"
            description="Optimizamos continuamente con data, no con intuición."
            colorVariant="secondary"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- TODO: CTA Intermedio -->
  <!-- <CTACard
		id="cta-intermedio"
		title="Diagnóstico IA Comercial — 30 minutos (gratuito)"
		description="Identificamos tus quick wins, los cuellos de botella de tu proceso comercial y las primeras oportunidades para aplicar IA sin reinventar nada."
		buttonText="Quiero mi diagnóstico"
		buttonHref="#contacto"
		buttonVariant="primary"
		backgroundVariant="soft"
